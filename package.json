{
  "name": "n8n-nodes-artefaktum",
  "version": "0.2.0",
  "description": "Store, find and reuse artifacts between n8n workflows and AI agents with Artefaktum",
  "license": "MIT",
  "homepage": "https://github.com/artefaktum-dev/n8n-nodes-artefaktum",
  "keywords": [
    "n8n-community-node-package",
    "artefaktum",
    "artifacts",
    "storage",
    "ai-agents"
  ],
  "author": {
    "name": "Tadas Malinauskas",
    "email": "support@artefaktum.dev",
    "url": "https://artefaktum.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/artefaktum-dev/n8n-nodes-artefaktum.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ArtefaktumApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Artefaktum/Artefaktum.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.49.1",
    "eslint": "9.32.0",
    "n8n-workflow": "^1.120.31",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
